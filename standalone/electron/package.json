{
  "name": "taiko-web-desktop",
  "version": "0.1.0",
  "description": "Electron launcher for Taiko Web with bundled backend server",
  "author": "Taiko Web Contributors",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "productName": "Taiko Web",
  "scripts": {
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist:win": "electron-builder --win --dir",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.taikoweb.desktop",
    "productName": "Taiko Web",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/taiko-web-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets/launcher",
        "to": "assets/launcher",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/launcher/app.ico",
      "artifactName": "TaikoWeb-${version}-win-unpacked"
    }
  },
  "devDependencies": {
    "cross-env": "^7",
    "electron": "^30",
    "electron-builder": "^24",
    "eslint": "^9",
    "prettier": "^3"
  },
  "dependencies": {
    "tree-kill": "^1"
  }
}

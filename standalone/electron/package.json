{
  "name": "taiko-web-desktop",
  "version": "0.1.0",
  "description": "Electron launcher for Taiko Web with bundled backend server",
  "author": "Taiko Web Contributors",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "productName": "Taiko Web",
  "scripts": {
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "start": "electron .",
    "lint": "eslint .",
    "build:backend": "python ../packaging/build_backend.py",
    "build:desktop": "npm run build:backend && electron-builder -mwl",
    "build:win": "npm run build:backend && electron-builder --win nsis zip",
    "build:mac": "npm run build:backend && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.taikoweb.desktop",
    "productName": "Taiko Web",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/taiko-web-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets/launcher",
        "to": "assets/launcher",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "../assets/launcher/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "TaikoWeb-${version}-${os}-${arch}.${ext}",
      "publisherName": "Taiko Web"
    },
    "mac": {
      "icon": "../assets/launcher/app.icns",
      "category": "public.app-category.games",
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ],
      "artifactName": "TaikoWeb-${version}-${os}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "cross-env": "^7",
    "electron": "^30",
    "electron-builder": "^24",
    "eslint": "^9",
    "prettier": "^3"
  },
  "dependencies": {
    "tree-kill": "^1"
  }
}

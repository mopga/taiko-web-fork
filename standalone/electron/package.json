{
  "name": "taiko-web-desktop",
  "version": "0.1.0",
  "productName": "Taiko Web Desktop (Fork)",
  "main": "main.js",
  "scripts": {
    "prebuild:backend": "python standalone/packaging/build_backend.py",
    "build:backend": "python standalone/packaging/build_backend.py",
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "build": "npm run build:backend && electron-builder --dir",
    "dist": "npm run build:backend && electron-builder",
    "lint": "eslint ."
  },
  "devDependencies": {
    "electron": "^30",
    "electron-builder": "^24",
    "cross-env": "^7",
    "eslint": "^9",
    "prettier": "^3"
  },
  "dependencies": {
    "electron-log": "^5",
    "tree-kill": "^1"
  }
}

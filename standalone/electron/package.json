{
  "name": "taiko-web-desktop",
  "version": "0.1.0",
  "description": "Electron-based desktop build of Taiko Web with bundled backend",
  "author": "Taiko Web Contributors",
  "productName": "Taiko Web Desktop",
  "main": "main.js",
  "scripts": {
    "prebuild:backend": "python ../packaging/build_backend.py",
    "build:backend": "python ../packaging/build_backend.py",
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "build": "npm run build:backend && electron-builder --dir",
    "dist": "npm run build:backend && electron-builder --win --dir",
    "lint": "eslint ."
  },
  "devDependencies": {
    "electron": "^30",
    "electron-builder": "^24",
    "cross-env": "^7",
    "eslint": "^9",
    "prettier": "^3"
  },
  "dependencies": {
    "electron-log": "^5",
    "tree-kill": "^1"
  }
}

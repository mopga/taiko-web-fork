# Если хочешь повесить приложение не в корень, укажи BASEDIR.
# Например: /taiko-web/  (не забудь закрывающий слэш)
BASEDIR=/

# TJA validation controls
TJA_VALIDATION_MODE=warn
TJA_VALIDATION_LOG=0
TJA_VALIDATION_SUMMARY=1

# Song scanner runtime (uncomment to override defaults)
# SCAN_ON_START=auto                        # auto (digest + incremental), force, or skip
# SCAN_LEADER_TTL_SECONDS=300               # Redis leader lock TTL in seconds
# SCAN_LEADER_REFRESH_SECONDS=75            # How often to refresh the leader lock (defaults to TTL/4)
# SCAN_IO_THREADS=16                        # Thread pool size for parsing headers (defaults to min(32, 2*CPU))
# MONGO_BULK_BATCH=800                      # UpdateOne operations per Mongo bulk_write
# SCAN_PROGRESS_EVERY_SECONDS=5             # Minimum seconds between INFO progress summaries
# SCAN_PROGRESS_EVERY_FILES=250             # Optional file-count gate for progress logs (0 disables)
# LEADER_CHECK_INTERVAL=200                 # Files to process before re-checking leadership